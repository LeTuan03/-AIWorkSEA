# --- Database: Supabase Postgres ---
# From Supabase dashboard → Project Settings → Database → Connection string.
# URL-encode special chars in the password (e.g. `@` -> %40).
#
# Runtime: transaction-mode pooler (IPv4-only, pgbouncer). Used by the app.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: session-mode pooler (direct, non-pooled). Used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# --- Auth.js ---
# Session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# --- Public base URL (canonical URLs, sitemap, OG metadata) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Newsletter (AI Jobs Digest) ---
# Resend API key. Without it, the app skips sending and logs the confirm link to
# the console (so double opt-in is still testable locally). Get one at resend.com.
RESEND_API_KEY=""
# Verified sender, e.g. "AIWork SEA <digest@yourdomain.com>". Defaults to Resend's
# onboarding sender if unset.
RESEND_FROM=""
# Shared secret for the weekly digest cron endpoint (/api/digest). Generate:
# openssl rand -base64 32. Must match the GitHub Action's CRON_SECRET secret.
CRON_SECRET=""

# --- Payments (Part B, not active yet) ---
# SePay webhook secret — leave empty until monetization is switched on (M5).
SEPAY_WEBHOOK_SECRET=""
